{
  "expo": {
    "name": "MarketMate",
    "slug": "marketmate",
    "version": "3.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marketmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.tvscavallaro.marketmate",
      "infoPlist": {
        "NSCameraUsageDescription": "Scatta foto della chiusura fiscale per calcolare la media scontrino",
        "NSPhotoLibraryUsageDescription": "Seleziona foto della chiusura fiscale dalla galleria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0F4F8"
      },
      "edgeToEdgeEnabled": true,
      "package": "it.tvscavallaro.marketmate",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0F4F8"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Seleziona foto della chiusura fiscale",
          "cameraPermission": "Scatta foto della chiusura fiscale"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1E7F85",
          "defaultChannel": "marketmate-reminders"
        }
      ],
      "./plugins/with-adi-registration"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
