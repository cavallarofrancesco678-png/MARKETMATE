{
  "expo": {
    "name": "MarketMate",
    "slug": "marketmate",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marketmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketmate.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scatta foto della chiusura fiscale per calcolare la media scontrino",
        "NSPhotoLibraryUsageDescription": "Seleziona foto della chiusura fiscale dalla galleria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F0F4F8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.marketmate.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0F4F8"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Seleziona foto della chiusura fiscale",
          "cameraPermission": "Scatta foto della chiusura fiscale"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
